# Optional server-side LLM fallbacks. Clients can also supply provider + key
# in the UI (sent as X-LLM-Provider / X-LLM-Api-Key / optional X-LLM-Model).
# Prefer client keys for demos / shared deploys.
#
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# LLM_API_KEY=   # generic fallback for whichever LLM_PROVIDER is set

# Optional model overrides (defaults shown)
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Comma-separated frontend origins allowed by FastAPI CORS
FRONTEND_ORIGIN=http://localhost:5173

# Optional — increases Semantic Scholar rate limits
SEMANTIC_SCHOLAR_API_KEY=

# Where Chroma stores its local vector index
CHROMA_DB_PATH=./chroma_data
